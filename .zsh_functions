# Shell functions - sourced from ~/.zshrc

# Note: parse_git_branch / parse_git_dirty have been replaced by zsh's
# built-in vcs_info (see ~/.zshrc). They were ~3-5x slower on large repos.

# Print the previous command's exit status when non-zero (for prompts)
nonzero_return() {
    local r=$?
    (( r != 0 )) && print -- "$r"
}

# git push --force-with-lease to a different remote branch
force_push_to_different_origin() {
    if (( $# != 2 )); then
        print -u2 "usage: force_push_to_different_origin <local> <remote>"
        return 2
    fi
    git push --force-with-lease origin "$1":"$2"
}

# Capture HTTP-style traffic on a port to capture.pcap
tcpdump_rest_requests() {
    local port=${1:?usage: tcpdump_rest_requests <port>}
    tcpdump -i lo -A -s 0 \
        '"tcp port $port and (((ip[2:2] - ((ip[0]&0xf)<<2)) - ((tcp[12]&0xf0)>>2)) != 0)"' \
        -w capture.pcap
}

# Print modified-file paths from `git status --short`
gtm() {
    git status --short | awk '/^.M/ {print $2}'
}

# Replace files in-place with their ASCII transliteration.
# Skips empty results and reports them.
convert_into_ascii() {
    local filename tmp
    for filename in "$@"; do
        tmp="${filename}.tmp"
        if iconv -f UTF-8 -t ASCII//TRANSLIT//IGNORE "$filename" > "$tmp" && [[ -s "$tmp" ]]; then
            mv "$tmp" "$filename"
        else
            rm -f "$tmp"
            print -u2 "warn: conversion failed or produced empty file: $filename"
        fi
    done
}

# Re-flow a markdown file: convert to ASCII, then run pandoc to wrap at 130 cols
format_md() {
    local filename=${1:?usage: format_md <file.md>}
    convert_into_ascii "$filename" || return
    pandoc "$filename" -o out.md -f markdown \
        -t markdown+fenced_code_blocks --wrap=auto --columns=130 \
        && mv out.md "$filename"
}

# Log into the AWS SSO profile and verify identity.
aws_login() {
    local profile="IDVerse---Play---Oscar-Downing/AdministratorAccess"
    aws sso login --profile "$profile"                  || return
    aws sts get-caller-identity --profile "$profile"    || return
    aws s3 ls --profile "$profile"
}

# Export AWS credentials as env vars for the current shell.
aws_export_credentials() {
    local profile=${1:?usage: aws_export_credentials <profile>}
    eval "$(aws configure export-credentials --profile "$profile" --format env)"
    AWS_DEFAULT_REGION=$(aws configure get region --profile "$profile")
    export AWS_DEFAULT_REGION
}

# Restricted gh copilot wrapper. Use `devpilot --plan` for a read-only session.
#
# ponytail: denies beat --allow-all-tools, so this list is the whole guardrail.
# Only unrecoverable, publishing, escalating, or exfiltrating commands. Everything
# else is recoverable from git or the reflog. Paths stay confined to the cwd.
devpilot() {
    gh copilot \
        -- \
        --model "${DEVPILOT_MODEL:-claude-opus-5}" \
        --allow-all-tools \
        --disallow-temp-dir \
        --add-dir "$HOME/.cargo/registry" \
        --secret-env-vars=AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,AWS_SESSION_TOKEN,GITHUB_TOKEN \
        --deny-tool='shell(rm)' \
        --deny-tool='shell(git clean)' \
        --deny-tool='shell(git push)' \
        --deny-tool='shell(git commit)' \
        --deny-tool='shell(sudo)' \
        --deny-tool='shell(bash)' \
        --deny-tool='shell(curl)' \
        --deny-tool='shell(wget)' \
        "$@"
}

# Sync the active rust toolchain with ~/.rust-toolchain
update_rust_version() {
    local toolchain_file="$HOME/.rust-toolchain"
    [[ -r "$toolchain_file" ]] || { print -u2 "missing $toolchain_file"; return 1 }
    rustup override set "$(<"$toolchain_file")"
}

# Quick `mkdir -p && cd`
mkcd() {
    local dir=${1:?usage: mkcd <dir>}
    mkdir -p -- "$dir" && cd -- "$dir"
}

# Extract any common archive type by extension
unpack() {
    local file=${1:?usage: unpack <archive>}
    [[ -r "$file" ]] || { print -u2 "cannot read: $file"; return 1 }
    case "${file:l}" in
        *.tar.bz2|*.tbz2) tar xjf  "$file" ;;
        *.tar.gz|*.tgz)   tar xzf  "$file" ;;
        *.tar.xz|*.txz)   tar xJf  "$file" ;;
        *.tar.zst)        tar --zstd -xf "$file" ;;
        *.tar)            tar xf   "$file" ;;
        *.bz2)            bunzip2  "$file" ;;
        *.gz)             gunzip   "$file" ;;
        *.xz)             unxz     "$file" ;;
        *.zip)            unzip    "$file" ;;
        *.7z)             7z x     "$file" ;;
        *.rar)            unrar x  "$file" ;;
        *) print -u2 "unsupported archive: $file"; return 1 ;;
    esac
}
